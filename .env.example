# ============================================================
# LeadHunter AI — environment variables (secrets ONLY).
# Copy to .env and fill in. NEVER commit real values.
# Settings (non-secrets) live in config.yaml, not here.
# Every variable here is OPTIONAL — the pipeline runs in
# dry-run/template mode without any of them. Modules that need
# a missing secret fail honestly with a ConfigError, never silently.
# ============================================================

# --- AI message personalization (Anthropic Claude) ---
ANTHROPIC_API_KEY=

# --- LLM personalization (OpenAI-compatible / OpenRouter) ---
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-chat

# --- Lead discovery: Google Places API (fallback provider) ---
GOOGLE_PLACES_API_KEY=

# --- Lead discovery: SerpAPI Google Maps ---
SERPAPI_KEY=

# --- Enrichment: email finder (optional; discovery works without) ---
APOLLO_API_KEY=
HUNTER_API_KEY=

# --- Outreach: WhatsApp via local Hermes bridge (localhost:3000) ---
# The bridge must be running and the session paired. Sending is
# approval-gated and blocked in dry-run mode regardless.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_OWNER_CHAT_ID=

# --- Outreach: Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Outreach: Gmail SMTP ---
GMAIL_APP_PASSWORD=

# --- Sender identity (used in personalized messages) ---
SENDER_NAME=
SENDER_EMAIL=

# --- Outreach Safety Switch (true = no real sends, false = real sends) ---
DRY_RUN=true

# --- Google Sheets audit logging (service account JSON) ---
# Create a service account, share the spreadsheet with its email.
GOOGLE_SHEETS_CREDS_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Leads!A1

# --- Demo landing pages: GitHub Pages publisher (optional) ---
# Needs a repo you can push to (https push with a PAT).
DEMO_GH_REPO=
GITHUB_TOKEN=

# --- Overrides (optional) ---
# LEADHUNTER_CONFIG=/abs/path/to/config.yaml
# LEADHUNTER_DATA_DIR=/abs/path/to/data
